{
  "manifest_version": 3,
  "name": "Obee — CoffeeStudio Clipper",
  "version": "0.1.0",
  "description": "Clip roaster pages from the web straight into CoffeeStudio.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Obee",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
